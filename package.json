{
    "name": "jordan-shurmer-family",
    "version": "1.1.0",
    "description": "Jordan Shurmer's Website",
    "main": ".eleventy.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "run-p build:*",
        "build:eleventy": "eleventy",
        "build:sass": "sass ./sass:./_site",
        "watch": "run-p watch:* serve",
        "watch:eleventy": "eleventy --watch",
        "watch:sass": "sass --watch ./sass:./_site",
        "serve": "serve ./_site",
        "checks": "exitzero npm-check -i ace"
    },
    "author": "Jordan Shurmer",
    "license": "ISC",
    "devDependencies": {
        "exitzero": "^1.0.1",
        "npm-check": "^5.9.2",
        "npm-run-all": "^4.1.5",
        "sass": "^1.32.0",
    },
    "dependencies": {}
}